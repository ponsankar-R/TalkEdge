# ==========================================================
# TalkEdge Node Server — Environment Variables
# These are PLACEHOLDER values. Replace them with your real
# Neon Postgres credentials and secrets before running the app.
# Never commit a filled-in .env to a public repository.
# ==========================================================

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Neon PostgreSQL ----
# Copy the "Pooled connection" string from your Neon dashboard
# Project -> Connection Details.
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=postgresql://your_neon_user:your_neon_password@your-project.neon.tech/your_database?sslmode=require

# ---- Auth / JWT ----
JWT_SECRET=replace_with_a_long_random_secret_key
JWT_EXPIRES_IN=1d

# ---- One-time admin seed (used only by `npm run seed:admin`) ----
# This creates the single admin account allowed to log in.
ADMIN_EMAIL=admin@talkedge.com
ADMIN_PASSWORD=ChangeThisPassword123!

# ---- CORS ----
# Origin of the admin-react-app dev server
ADMIN_CLIENT_ORIGIN=http://localhost:5173
